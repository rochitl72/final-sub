 "_about": "Reasoning layer for the Scenario Engine: who is liable, which facts make an offence apply, how offences relate, and the criminal-law (BNS) layer for injury and death. Applied to data/drivelegal.db by scripts/apply_law_enrichment.py (idempotent). Every row cites a source key; amounts and terms must be re-verified against India Code before production use.",
 "version": 2,
 "sources": [
  {
   "key": "mva",
   "title": "Motor Vehicles Act, 1988 (as amended by the MV (Amendment) Act, 2019)",
   "url": "https://www.indiacode.nic.in",
   "note": "Central penalties; states may compound at lower amounts."
  },
  {
   "key": "bns",
   "title": "Bharatiya Nyaya Sanhita, 2023",
   "url": "https://www.indiacode.nic.in",
   "note": "In force from 1 July 2024 except section 106(2), which was kept in abeyance."
  },
  {
   "key": "cmvr",
   "title": "Central Motor Vehicles Rules, 1989",
   "url": "https://www.indiacode.nic.in",
   "note": "Equipment and conduct rules; penalty under MV Act s.177 unless specified."
  }
 ],
 "provisions": [
  {
   "act": "MV Act 1988",
   "section": "134",
   "title": "Duty of driver in case of accident and injury",
   "summary": "Driver must secure medical attention for the injured and report the accident to police within 24 hours.",
   "source": "mva"
  },
  {
   "act": "MV Act 1988",
   "section": "161",
   "title": "Compensation in hit-and-run cases",
   "summary": "Victims of hit-and-run get fixed compensation from the Motor Vehicle Accident Fund: ₹2,00,000 for death, ₹50,000 for grievous hurt. Claim through the district claims enquiry officer.",
   "source": "mva"
  },
  {
   "act": "MV Act 1988",
   "section": "177",
   "title": "General penalty",
   "summary": "Contravention with no specific penalty: fine up to ₹500; repeat up to ₹1,500.",
   "max_fine": 1500,
   "source": "mva"
  },
  {
   "act": "MV Act 1988",
   "section": "180",
   "title": "Allowing unauthorised persons to drive",
   "summary": "Owner or person in charge who lets someone without a valid licence drive: up to 3 months, or fine up to ₹5,000, or both.",
   "max_fine": 5000,
   "max_jail": "up to 3 months",
   "source": "mva"
  },
  {
   "act": "MV Act 1988",
   "section": "181",
   "title": "Driving without licence / underage",
   "summary": "Driving without a licence or below the minimum age: up to 3 months, or fine up to ₹5,000, or both.",
   "max_fine": 5000,
   "max_jail": "up to 3 months",
   "source": "mva"
  },
  {
   "act": "MV Act 1988",
   "section": "184",
   "title": "Driving dangerously",
   "summary": "First offence: 6 months to 1 year, or fine ₹1,000–5,000, or both. Repeat within 3 years: up to 2 years, or fine up to ₹10,000, or both.",
   "max_fine": 10000,
   "max_jail": "up to 2 years (repeat)",
   "source": "mva"
  },
  {
   "act": "MV Act 1988",
   "section": "185",
   "title": "Driving by a drunken person or under drugs",
   "summary": "First offence: up to 6 months, or fine up to ₹10,000, or both. Repeat within 3 years: up to 2 years, or fine up to ₹15,000, or both.",
   "max_fine": 15000,
   "max_jail": "up to 2 years (repeat)",
   "source": "mva"
  },
  {
   "act": "MV Act 1988",
   "section": "187",
   "title": "Offences relating to accident",
   "summary": "Failing to stop, help or report under s.132/133/134: up to 6 months, or fine up to ₹5,000, or both.",
   "max_fine": 5000,
   "max_jail": "up to 6 months",
   "source": "mva"
  },
  {
   "act": "MV Act 1988",
   "section": "194",
   "title": "Driving vehicle exceeding permissible weight",
   "summary": "Whoever drives or causes or allows an overloaded goods vehicle: ₹20,000 plus ₹2,000 per extra tonne; the excess load must be offloaded.",
   "source": "mva"
  },
  {
   "act": "MV Act 1988",
   "section": "194A",
   "title": "Carriage of excess passengers",
   "summary": "Whoever drives or causes or allows a transport vehicle to carry excess passengers: ₹200 per extra passenger.",
   "source": "mva"
  },
  {
   "act": "MV Act 1988",
   "section": "194B",
   "title": "Safety belts and child restraints",
   "summary": "Driving without a seat belt or carrying passengers not wearing seat belts: ₹1,000. Child under 14 not secured: ₹1,000.",
   "max_fine": 1000,
   "source": "mva"
  },
  {
   "act": "MV Act 1988",
   "section": "194C",
   "title": "Overloading of two-wheelers",
   "summary": "More than one pillion: ₹1,000 and licence disqualification for 3 months.",
   "max_fine": 1000,
   "source": "mva"
  },
  {
   "act": "MV Act 1988",
   "section": "194D",
   "title": "Protective headgear",
   "summary": "Rider or pillion without a helmet: ₹1,000 and licence disqualification for 3 months.",
   "max_fine": 1000,
   "source": "mva"
  },
  {
   "act": "MV Act 1988",
   "section": "196",
   "title": "Driving uninsured vehicle",
   "summary": "Whoever drives or causes or allows an uninsured vehicle: up to 3 months, or ₹2,000, or both; repeat ₹4,000.",
   "max_fine": 4000,
   "max_jail": "up to 3 months",
   "source": "mva"
  },
  {
   "act": "MV Act 1988",
   "section": "199A",
   "title": "Offences by juveniles",
   "summary": "When a juvenile commits an offence, the guardian or owner is deemed guilty: up to 3 years and ₹25,000. Registration cancelled for 12 months; the juvenile cannot get a licence until 25. The juvenile is dealt with under the Juvenile Justice Act.",
   "max_fine": 25000,
   "max_jail": "up to 3 years",
   "source": "mva"
  },
  {
   "act": "BNS 2023",
   "section": "106(1)",
   "title": "Causing death by negligence",
   "summary": "Causing death by a rash or negligent act: up to 5 years and fine.",
   "max_jail": "up to 5 years",
   "source": "bns"
  },
  {
   "act": "BNS 2023",
   "section": "106(2)",
   "title": "Death by rash driving and escaping",
   "summary": "Causing death by rash or negligent driving and escaping without reporting: up to 10 years and fine. Not yet in force (kept in abeyance).",
   "max_jail": "up to 10 years",
   "note": "Not notified as of the 1 July 2024 commencement.",
   "source": "bns"
  },
  {
   "act": "BNS 2023",
   "section": "125",
   "title": "Act endangering life or personal safety",
   "summary": "Rash or negligent act endangering life: up to 3 months or ₹2,500. Causing hurt: up to 6 months or ₹5,000. Causing grievous hurt: up to 3 years or ₹10,000.",
   "max_fine": 10000,
   "max_jail": "up to 3 years (grievous hurt)",
   "source": "bns"
  },
  {
   "act": "BNS 2023",
   "section": "281",
   "title": "Rash driving on a public way",
   "summary": "Driving so rashly or negligently as to endanger human life: up to 6 months, or fine up to ₹1,000, or both.",
   "max_fine": 1000,
   "max_jail": "up to 6 months",
   "source": "bns"
  }
 ],
