# DriveLegal API keys — copy to .env in the repo root (never commit .env)
#
#   cp config/.env.example .env
#   # then edit .env with your keys

# Sarvam AI — TTS, translation, Sarvam-M LLM (https://www.sarvam.ai/)
SARVAM_API_KEY=

# Groq — cloud narrate / chat fallback (https://console.groq.com/) — free tier for demo
GROQ_CHAT_API_KEY=
# Optional — pin a Groq chat model (default: first available of
# openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b, …)
GROQ_CHAT_MODEL=

# Groq — optional; gov.in patch scraper only
GROQ_API_KEY=
