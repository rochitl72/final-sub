# Copy to .env in this folder (the repo root)
# Prefer the sanitized template:
#
#   cp config/.env.example .env
#
# See SETUP.md for key descriptions.

SARVAM_API_KEY=
GROQ_CHAT_API_KEY=
GROQ_CHAT_MODEL=
GROQ_API_KEY=

# ── LLM provider ─────────────────────────────────────────────────────────────
# Production: the org's self-hosted Ollama. Leave LLM_PROVIDER unset and the
# backend uses Ollama whenever OLLAMA_URL is set, Groq otherwise.
LLM_PROVIDER=ollama
OLLAMA_URL=http://10.42.235.232:11434/api/generate
# OLLAMA_MODEL=            # e.g. qwen2.5:14b — default: best model the server lists
# OLLAMA_EXTRACT_MODEL=    # optional bigger model for story understanding
# OLLAMA_TIMEOUT=60
# OLLAMA_MAX_PARALLEL=2
# OLLAMA_NUM_CTX=8192
# OLLAMA_THINK=false
# LLM_ASYNC_EXTRACT=1      # answer from rules instantly, refine with the LLM in the background
